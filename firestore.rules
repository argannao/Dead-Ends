rules_version = '2';
// Règles de sécurité Firestore pour Dead Ends.
// À coller dans la console Firebase : Firestore Database > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {

    // Profils publics (pseudo, photo, code ami, statistiques, présence).
    // Tout joueur connecté peut les lire (pour la liste d'amis), chacun ne modifie que le sien.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      // Réglages privés (clé CARTO) : visibles uniquement par leur propriétaire.
      match /private/{doc} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Amitiés : un document par paire de joueurs, identifiant "uidA_uidB" (ordre alphabétique).
    match /friendships/{id} {
      function isMember() {
        return request.auth != null && request.auth.uid in resource.data.members;
      }
      // Lecture d'une paire précise (même inexistante, pour vérifier avant d'envoyer une demande)
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      // Liste de mes amitiés (requête « members contient mon uid »)
      allow list: if request.auth != null && request.auth.uid in resource.data.members;

      // Demande d'ami : créée par l'un des deux joueurs, en attente.
      allow create: if request.auth != null
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + "_" + request.resource.data.members[1];

      // Acceptation : uniquement par le joueur qui a reçu la demande.
      allow update: if isMember()
        && resource.data.requester != request.auth.uid
        && request.resource.data.status == "accepted"
        && request.resource.data.members == resource.data.members
        && request.resource.data.requester == resource.data.requester;

      // Refus, annulation ou suppression d'un ami : par l'un ou l'autre.
      allow delete: if isMember();
    }

    // Course contre la montre : meilleur temps de chaque joueur sur un trajet.
    match /routes/{route}/times/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.time is number && request.resource.data.time > 3 && request.resource.data.time < 36000
        && request.resource.data.name is string && request.resource.data.name.size() <= 16;
      allow delete: if false;
    }

    // Défi du jour : meilleur temps de survie de chaque joueur pour une date.
    match /daily/{day}/scores/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.time is number && request.resource.data.time >= 0 && request.resource.data.time < 36000
        && request.resource.data.name is string && request.resource.data.name.size() <= 16;
      allow delete: if false;
    }
  }
}
